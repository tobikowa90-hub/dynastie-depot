# OneDrive temp files
.tmp.drivedownload/
.tmp.driveupload/
~$*

# Archive (historisch, nicht fuer Remote Agent relevant)
# Pattern mit /* statt /, damit Whitelist-Exceptions fuer JSONL greifen koennen
05_Archiv/*

# Exception: Backtest-Ready JSONL-Archive MUESSEN git-tracked sein (Spec §3 append-only)
!05_Archiv/score_history.jsonl
!05_Archiv/flag_events.jsonl
# Exception: R5 Portfolio-Return-Persistenz (Track 3 Phase 3, 19.04.2026)
!05_Archiv/portfolio_returns.jsonl
!05_Archiv/benchmark-series.jsonl
!05_Archiv/schema-portfolio-returns.md
# Skill-Pakete (ZIPs, nicht fuer Remote Agent)
06_Skills-Pakete/

# Superpowers docs (nur lokal relevant)
docs/superpowers/

# Code-Review-Artefakte (lokal: Codex/CodeRabbit/Gemini-Logs pro CP-Checkpoint)
.reviews/

# Lock files (LibreOffice/Excel)
.~lock.*

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Claude Code personal settings (per-user permissions, not for remote agents)
.claude/settings.local.json

# Claude Code skill-discovery junctions (Windows NTFS-local, no cross-OS meaning)
.claude/skills/

# Legacy Ruflo runtime artifacts (Ruflo sunset 2026-05-13 Hard-Rollback; ignore-patterns bleiben für historische Re-Install-Sicherheit)
.swarm/
.claude/memory.db
.claude/memory.db-shm
.claude/memory.db-wal
agentdb.rvf
agentdb.rvf.lock
claude-flow.config.json

# Claude Code scheduled-tasks runtime lock (sessionId+pid, ephemeral)
.claude/scheduled_tasks.lock

# Python bytecode cache
__pycache__/
*.pyc

# Ruff cache (regenerable, per-machine)
.ruff_cache/

# CodeRabbit review output (ephemeral, regenerable via `coderabbit review`)
.cr_*.txt

# Backtest-Ready ephemere Draft-Handoffs (Skill backtest-ready-forward-verify)
03_Tools/backtest-ready/_drafts/*.json

# Hook-Latency-Probe-History (ephemeral JSONL — regenerable via 03_Tools/hook-latency-probe.py)
03_Tools/hook-latency-history/

# FinnHub Crosswalk-Log (operational, append-only, regenerable via finnhub_crosswalk_trigger.py)
03_Tools/finnhub_crosswalk_log.jsonl

# paragraph-18-sync Session-Marker (Two-Commit-Protokoll, ephemeral, TTL 4h)
03_Tools/para18_sync/.session_marker

# Obsidian per-Session UI state (tabs, layout, pan/zoom) — ephemeral, not shared config
07_Obsidian Vault/Obsidian Mindmap/.obsidian/workspace.json
07_Obsidian Vault/Obsidian Mindmap/.obsidian/graph.json

# Video-Ingest-Pipeline transient artifacts (yt-dlp + whisper)
# Persisting artifacts (transcript.md/info.json/chapters.json/run.log) stay tracked.
07_Obsidian Vault/Obsidian Mindmap/Investing Mastermind/raw/videos/**/*.m4a
07_Obsidian Vault/Obsidian Mindmap/Investing Mastermind/raw/videos/**/*.mp3
07_Obsidian Vault/Obsidian Mindmap/Investing Mastermind/raw/videos/**/*.webm
07_Obsidian Vault/Obsidian Mindmap/Investing Mastermind/raw/videos/**/whisper_raw.json

# Legacy Ruflo-MCP runtime side-effect (cwd-relativ vector-store; Ruflo sunset 2026-05-13)
ruvector.db

# pre-commit-Substrate Test-Fixtures (Spec §5.2): deterministisch regenerable
# via 03_Tools/precommit/_fixtures/_generate_fixtures.py — Generator +
# _smoke_test.py sind die getrackte SSoT. Binär-xlsx + CRLF-Inputs nicht
# tracken (Diff-Noise + CRLF-im-Repo-Komplikation vermeiden).
03_Tools/precommit/_fixtures/*.input
03_Tools/precommit/_fixtures/*.xlsx

